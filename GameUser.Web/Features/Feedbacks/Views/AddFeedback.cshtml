@using GameUser.Web.Features.Feedbacks.ViewModels;
@model InsertFeedbackViewModel;

@section Styles {
    <link href="~/scss/feedback.min.css" rel="stylesheet" asp-append-version="true" />
}

<div class="feedback">
    <form asp-action="AddFeedback" asp-controller="Feedback" method="post" id="gameForm" enctype = "multipart/form-data">
         <div class="form-group row">
             <div class="col-lg-12 row-item">
                <label asp-for="@Model.Feedback.Category" class="control-label">
                    Please first let us know what you'd like to do:
                </label>
            </div>
            <div class="col-lg-12 row-item">
                <select asp-for="@Model.Feedback.Category" required asp-items="@Model.FeedbackTypeOptions" class="form-control"></select>
            </div>
             <div class="col-lg-12 row-item">
                <label asp-for="@Model.Feedback.Category" class="control-label">
                    Description
                </label>
                 <span id="failedMsg"><i class="icon-cancel"></i><span id="failedMsgContent"></span></span>
            </div>                        
             <div class="col-lg-12 row-item">
                <textarea id="descText" type="text" asp-for="@Model.Feedback.Description" 
                          class="form-control desc-input" cols="50" rows="12"
                          OnKeyUp="feedback.onDescKeyUp()">
                </textarea>
                <span asp-validation-for="@Model.Feedback.Description" class="text-danger"></span>
            </div>       
             <div class="col-lg-12 row-item image-container" >
                 <ul id="imageContainer">
                     <li class="added-image" hidden>
                        <img />
                         <input type="file" class="to-add-input" name="Feedback.Files" hidden onchange="feedback.onFileInputChanged(this)">
                     </li>
                     <li class="to-add-image" onclick="feedback.openSelectFile()">
                         <img />                         
                     </li>                     
                 </ul>
             </div>
             <div class="col-lg-12 row-item">
                 <button type="button" class="btn-gray" data-dismiss="modal" onclick="feedback.submit()" id="submitBtn">Submit</button>
             </div>
        </div>
    </form>     
    
</div>

<div class="modal fade edit-modal" id="editModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Edit Config</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body details-content" id="editdetails">
                ...
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-gray" data-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-submit" id="updateBtn" onclick="feedback.showModal()">Save</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/jquery-unobtrusive-ajax/jquery.unobtrusive-ajax.js"></script>
    <script src="~/js/feedback.min.js" asp-append-version="true"></script>
}