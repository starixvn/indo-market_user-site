    </EmbeddedResource>
    <EmbeddedResource Update="Shared\Resources\Resources.zh-TW.resx">
      <SubType>Designer</SubType>
    </EmbeddedResource>
    <EmbeddedResource Update="Shared\Resources\Resources.en-US.resx">
